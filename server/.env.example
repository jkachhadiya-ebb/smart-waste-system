# =============================================
# Smart Waste System – Server Environment
# Copy to .env and fill in actual values.
# =============================================

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_waste
# Individual pool vars (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=smart_waste

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173

# ---- SMTP (nodemailer) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@smartwaste.local

# ---- Password Reset ----
RESET_TOKEN_EXPIRES_HOURS=1
FRONTEND_URL=http://localhost:5173

# ---- 2FA / TOTP Encryption ----
# 32-byte hex key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# ---- Simulator ----
# Set to 'true' to activate the Koblenz telemetry simulator (dev only).
ENABLE_SIMULATOR=false

# ---- Route Optimization ----
# ROUTE_OPTIMIZATION_LIVE_TTL_MS=600000
# ROUTE_OPTIMIZATION_LIVE_DEBOUNCE_MS=3000
# ROUTE_OPTIMIZATION_LIVE_LOOKBACK_MINUTES=180

# ---- Carbon Tax ----
# EUR per tonne CO2e (German BEHG 2025 default: 55)
# CO2_TAX_EUR_PER_TONNE=55

# ---- Server ----
PORT=5000
NODE_ENV=development
